{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/kontaktas.html",
      "destination": "/#kontaktai",
      "permanent": true
    },
    {
      "source": "/kontaktas",
      "destination": "/#kontaktai",
      "permanent": true
    },
    {
      "source": "/aciu.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/aciu",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/privatumas.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/privatumas",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/demo/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
